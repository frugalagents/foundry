{
  "id": "scenario-suite:coding-platform-r0-1",
  "version": "1.1.0",
  "catalog_id": "catalog:coding-platform",
  "catalog_version": "3.0.0",
  "baseline_requirements": {
    "requirement:approved-package-registries": true,
    "requirement:concurrent-agent-tasks": 100,
    "requirement:developer-count": 5000,
    "requirement:enterprise-identity": "entra",
    "requirement:execution-placement": "customer-managed",
    "requirement:restricted-egress": false,
    "requirement:runtime-isolation": "container",
    "requirement:source-control": "gitlab-saas"
  },
  "scenarios": [
    {
      "id": "scenario:developer-local-positive",
      "version": "1.1.0",
      "kind": "positive",
      "target_pattern_id": "pattern:developer-local",
      "requirements": {
        "requirement:execution-placement": "local",
        "requirement:runtime-isolation": "developer-endpoint"
      },
      "expected_status": "feasible"
    },
    {
      "id": "scenario:developer-local-rejection",
      "version": "1.1.0",
      "kind": "rejection",
      "target_pattern_id": "pattern:developer-local",
      "requirements": {
        "requirement:execution-placement": "local",
        "requirement:runtime-isolation": "microvm"
      },
      "expected_status": "rejected",
      "expected_rejection_rule_ids": [
        "rule:reject-developer-local-isolation"
      ]
    },
    {
      "id": "scenario:developer-local-unknown",
      "version": "1.1.0",
      "kind": "unknown",
      "target_pattern_id": "pattern:developer-local",
      "requirements": {
        "requirement:execution-placement": "local",
        "requirement:runtime-isolation": "developer-endpoint"
      },
      "unset_requirements": ["requirement:runtime-isolation"],
      "expected_status": "unknown",
      "expected_blocking_requirement_ids": [
        "requirement:runtime-isolation"
      ]
    },
    {
      "id": "scenario:developer-local-one-variable-flip",
      "version": "1.1.0",
      "kind": "one_variable_flip",
      "target_pattern_id": "pattern:developer-local",
      "requirements": {
        "requirement:execution-placement": "local",
        "requirement:runtime-isolation": "developer-endpoint"
      },
      "flip": {
        "requirement_id": "requirement:runtime-isolation",
        "from": "developer-endpoint",
        "to": "microvm",
        "expected_before_status": "feasible",
        "expected_after_status": "rejected",
        "expected_rejection_rule_ids": [
          "rule:reject-developer-local-isolation"
        ]
      }
    },
    {
